# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Direct Postgres URL for `npm run db:seed` (Supabase → Connect → Session pooler). Server/CLI only.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Public site URL used in emails / QR codes (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public address put in shared/emailed links and QR codes when the site URL above is localhost (optional)
NEXT_PUBLIC_PUBLIC_URL=https://carry-me-back-kedarnath.vercel.app

# Email (Resend free tier: 3,000/month). Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Carry Me Back – Nagar Panchayat Kedarnath <certificates@yourdomain.in>"
EMAIL_REPLY_TO=npkedarnath@example.in

# Secret shared with the mobile app for POST /api/mobile-ingest (generate: openssl rand -hex 32)
MOBILE_APP_KEY=change-me-to-a-long-random-secret

# Secret used by the Supabase Database Webhook that calls /api/webhooks/certificate-created
WEBHOOK_SECRET=change-me-to-another-long-random-secret

# Protects /api/cron/daily-summary (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-to-a-third-long-random-secret
